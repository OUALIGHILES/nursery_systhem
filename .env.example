# ============================================================
# Nursery Management System — environment configuration example
# Copy to .env and fill in your own values. NEVER commit .env.
# AWS credentials are resolved via AWS CLI profiles, env vars
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) or IAM roles —
# never placed in this file for production.
# ============================================================

# ---- Database (PostgreSQL) ----
POSTGRES_USER=nursery
POSTGRES_PASSWORD=change-me-in-local-env
POSTGRES_DB=nursery
DATABASE_URL=postgresql://nursery:change-me-in-local-env@localhost:5432/nursery?schema=public

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Kafka (local KRaft cluster; MSK in production) ----
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=nursery-api
KAFKA_CONSUMER_GROUP=nursery-workers
KAFKA_SSL=false
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
KAFKA_REQUEST_TIMEOUT_MS=10000

# ---- Outbox relay (worker process only) ----
OUTBOX_BATCH_SIZE=50
OUTBOX_RELAY_INTERVAL_MS=2000
# Historical backlog hold: PENDING events created before this instant are
# never auto-published. Inspect via GET /api/v1/admin/outbox/pending and use
# POST /api/v1/admin/outbox/skip|release/:eventId (admin only). Empty = hold all history.
OUTBOX_HISTORICAL_CUTOFF_ISO=

# ---- API ----
API_PORT=4000
API_URL=http://localhost:4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace-with-long-random-string-access
JWT_REFRESH_SECRET=replace-with-long-random-string-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Argon2id memory cost (KiB)
ARGON2_MEMORY_COST=65536

# ---- Web (Next.js) ----
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=Little Steps Nursery

# ---- Email (SMTP). If unset, emails are logged instead of sent ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Little Steps Nursery <no-reply@example.com>"
SMTP_SECURE=false
SMTP_VERIFY_ON_STARTUP=true

# ---- Object storage (S3). If AWS_S3_BUCKET unset, uploads stored on local disk under ./uploads ----
AWS_REGION=eu-west-1
AWS_S3_BUCKET=
AWS_S3_DOCUMENTS_PREFIX=documents/
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=10
CHAT_MESSAGE_RETENTION_DAYS=730

# ---- Payments (Stripe-compatible provider interface; keys optional) ----
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Data retention (days) ----
RETENTION_AUDIT_DAYS=365
RETENTION_NOTIFICATION_DAYS=90
RETENTION_MESSAGE_DAYS=730

# ---- Seed (development only; fictional data) ----
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe!123
